<Window x:Class="DataMigrator.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр"
        Width="760" Height="560"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        FontSize="14">
    <DockPanel Margin="16">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Button DockPanel.Dock="Bottom" Content="Закрыть" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        <ListBox x:Name="List" Background="White" BorderBrush="#D5DCE3">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="#5E6A75" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Explanation}" Foreground="#5E6A75" TextWrapping="Wrap" FontSize="13"/>
                        <TextBlock Text="{Binding PathDisplay, TargetNullValue=''}" Foreground="#5E6A75" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
