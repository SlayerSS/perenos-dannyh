<Window x:Class="DataMigrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DataMigrator.Converters"
        xmlns:m="clr-namespace:DataMigrator.Models"
        Title="{x:Static m:Brand.WindowTitle}"
        Icon="Assets/app.ico"
        Width="1220" Height="840"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Language="ru-RU"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <DataTemplate x:Key="DriveTemplate">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding FreeText}" Foreground="#5E6A75" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TypeText}" Foreground="#5E6A75" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Border Background="#0E7C66" CornerRadius="8" Padding="14,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static m:Brand.Phone}" Foreground="White" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Right"/>
                        <TextBlock Text="{x:Static m:Brand.Email}" Foreground="#D7F3EC" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static m:Brand.Name}" Foreground="White" FontWeight="SemiBold" FontSize="20"/>
                        <TextBlock Text="{x:Static m:Brand.Tagline}" Foreground="#D7F3EC" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock TextWrapping="Wrap" Foreground="#3D4850" Margin="2,8,2,0"
                       Text="Копируются только ваши файлы и настройки. Сами программы на новом компьютере нужно установить отдельно."/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
            <Border Margin="0,0,8,0" Padding="12,8" CornerRadius="8" BorderThickness="1.5" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#D5DCE3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbBackup}" Value="True">
                                <Setter Property="Background" Value="#E7F6F0"/>
                                <Setter Property="BorderBrush" Value="#0E7C66"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <RadioButton x:Name="RbBackup" GroupName="Mode" Tag="LiveToFolder" Checked="Mode_Checked" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Живая система → папка" FontWeight="SemiBold"/>
                        <TextBlock Text="Сохранить данные этого компьютера на диск или флешку" Foreground="#5E6A75" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>
            </Border>
            <Border Margin="0,0,8,0" Padding="12,8" CornerRadius="8" BorderThickness="1.5" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#D5DCE3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbRestore}" Value="True">
                                <Setter Property="Background" Value="#E7F6F0"/>
                                <Setter Property="BorderBrush" Value="#0E7C66"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <RadioButton x:Name="RbRestore" GroupName="Mode" Tag="FolderToLive" Checked="Mode_Checked" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Папка → живая система" FontWeight="SemiBold"/>
                        <TextBlock Text="Вернуть ранее сохранённую копию этому пользователю" Foreground="#5E6A75" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>
            </Border>
            <Border Padding="12,8" CornerRadius="8" BorderThickness="1.5" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#D5DCE3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbDisk}" Value="True">
                                <Setter Property="Background" Value="#E7F6F0"/>
                                <Setter Property="BorderBrush" Value="#0E7C66"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <RadioButton x:Name="RbDisk" GroupName="Mode" Tag="DiskToLive" Checked="Mode_Checked" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Диск → живая система" FontWeight="SemiBold"/>
                        <TextBlock Text="Взять профиль со старого диска и перенести сюда" Foreground="#5E6A75" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D5DCE3" BorderThickness="1" CornerRadius="8" Padding="14,12" IsEnabled="{Binding IsIdle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PathLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Обзор…" Margin="8,0,0,0" Click="Browse_Click" Style="{StaticResource SecondaryButton}"/>
                        <TextBox Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LiveSourceLine}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding ShowLiveSource, Converter={StaticResource BoolVis}}"/>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding ShowProfileRow, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Профиль или копия" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="Display" MinHeight="34" SelectionChanged="Profile_SelectionChanged"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentUserLine}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ShowCurrentUserDestination, Converter={StaticResource BoolVis}}"/>

                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                        <Button DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" Style="{StaticResource LinkButton}"/>
                        <TextBlock Text="Диски" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                             ItemTemplate="{StaticResource DriveTemplate}"
                             SelectionChanged="Drive_SelectionChanged"
                             BorderBrush="#D5DCE3" Background="White">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemovable}" Value="True">
                                        <Setter Property="Background" Value="#E5F6EE"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReady}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D5DCE3" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Content="Найти данные" Click="Find_Click" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="{Binding IsIdle}"/>
                        <StackPanel>
                            <TextBlock Text="Найденные данные" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="{Binding SelectionSummary}" Foreground="#0E7C66" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,4" CornerRadius="6"
                            Background="#FFF6E8" BorderBrush="#E0B15A" BorderThickness="1"
                            Visibility="{Binding NeedsAccess, Converter={StaticResource BoolVis}}">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Right" Content="Дать доступ" Margin="12,0,0,0" Click="Grant_Click" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#6B4A12" FontSize="13" VerticalAlignment="Center"
                                       Text="Нет прав на чужой профиль. Поиск всё равно можно запустить: откроется то, что читается."/>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Foreground="#3D4850" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SourceCaption}" TextWrapping="Wrap" Foreground="#8A5A00" FontWeight="SemiBold" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#5E6A75" Margin="0,24,0,0" FontSize="15" TextAlignment="Center"
                               Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolVis}}"
                               Text="Нажмите «Найти данные». Слева появятся разделы, справа — файлы и настройки, которые можно перенести."/>

                    <Grid Visibility="{Binding HasAnyItems, Converter={StaticResource BoolVis}}" IsEnabled="{Binding IsIdle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                                 BorderThickness="0" Background="Transparent" Margin="0,0,10,0"
                                 ItemContainerStyle="{StaticResource SectionItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#E7F6F0" CornerRadius="10" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CountText}" Foreground="#0E7C66" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DockPanel Grid.Column="1" Visibility="{Binding HasSelectedSection, Converter={StaticResource BoolVis}}">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedSection.Title}" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="{Binding SelectedSection.Hint}" Foreground="#5E6A75" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Отметить раздел" Tag="{Binding SelectedSection.Key}" Click="SelectAll_Click" Style="{StaticResource LinkButton}" Margin="0,0,16,0"/>
                                    <Button Content="Снять раздел" Tag="{Binding SelectedSection.Key}" Click="SelectNone_Click" Style="{StaticResource LinkButton}" Margin="0,0,16,0"/>
                                    <Button Content="Отметить всё" Click="SelectEverything_Click" Style="{StaticResource LinkButton}" Margin="0,0,16,0"/>
                                    <Button Content="Снять всё" Click="ClearEverything_Click" Style="{StaticResource LinkButton}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border DockPanel.Dock="Top" Background="#F7F9FB" BorderBrush="#E6ECF0" BorderThickness="0,0,0,1" Padding="10,7,28,7" CornerRadius="6,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="168"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Название" FontSize="12" FontWeight="SemiBold" Foreground="#5E6A75"/>
                                    <TextBlock Grid.Column="2" Text="Путь" FontSize="12" FontWeight="SemiBold" Foreground="#5E6A75"/>
                                    <TextBlock Grid.Column="3" Text="Размер" FontSize="12" FontWeight="SemiBold" Foreground="#5E6A75" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ListBox ItemsSource="{Binding SelectedSection.Items}"
                                     BorderBrush="#E6ECF0" BorderThickness="1" Background="White"
                                     ItemContainerStyle="{StaticResource ResultItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                                     ScrollViewer.CanContentScroll="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding PathDisplay}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="168"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayName}"/>
                                                <TextBlock Text="{Binding Explanation}" Foreground="#5E6A75" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Margin="0,1,0,0" ToolTip="{Binding Explanation}"/>
                                                <TextBlock Text="{Binding Notes}" Foreground="#8A5A00" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Margin="0,1,0,0" ToolTip="{Binding Notes}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                                <Trigger Property="Text" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding PathDisplay, TargetNullValue=—}" VerticalAlignment="Center"
                                                       Foreground="#5E6A75" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                                       ToolTip="{Binding PathDisplay}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Right" TextAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,12,0,0" Background="White" BorderBrush="#D5DCE3" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" IsEnabled="{Binding IsIdle}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Content="Заменять существующие файлы" IsChecked="{Binding OverwriteExisting}" VerticalAlignment="Center" Margin="16,0,16,0"/>
                        <CheckBox Content="При замене сохранить прежний файл как .bak"
                                  IsChecked="{Binding KeepBak}" IsEnabled="{Binding OverwriteExisting}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PolicyText}" Foreground="#5E6A75" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Просмотр" Margin="0,0,8,0" Click="Preview_Click"
                            Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsIdle}"/>
                    <Button Grid.Column="1" Content="Начать" Margin="0,0,8,0" Click="Start_Click"
                            Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsIdle}"/>
                    <Button Grid.Column="2" Content="Отмена" Margin="0,0,12,0" Click="Cancel_Click"
                            Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsBusy}"/>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                     IsIndeterminate="{Binding ProgressIndeterminate}"/>
                        <TextBlock Text="{Binding CurrentFileText}" Foreground="#5E6A75" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Expander x:Name="LogExpander" Grid.Row="4" Margin="2,8,2,0" IsExpanded="False">
            <Expander.Header>
                <TextBlock Text="Журнал" FontWeight="SemiBold"/>
            </Expander.Header>
            <TextBox x:Name="LogBox" Height="120" Margin="0,6,0,0"
                     Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                     FontSize="13" BorderBrush="#D5DCE3" TextChanged="LogBox_TextChanged"/>
        </Expander>
    </Grid>
</Window>
